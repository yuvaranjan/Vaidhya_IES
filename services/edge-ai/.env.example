# services/edge-ai/.env — copy to .env and fill in. Never commit .env.
# Node A (village edge, RTX 5060) only.

JURISDICTION_ID=jur_thrissur_01
WEB_ORIGIN=http://localhost:3000

# --- providers -------------------------------------------------------
STT_PROVIDER=groq
TTS_PROVIDER=edge_tts
TRANSLATE_PROVIDER=bank
EDGE_LLM_PROVIDER=lmstudio

EDGE_LLM_URL=http://localhost:1234/v1
EDGE_LLM_MODEL=qwen2.5-7b-instruct
EDGE_LLM_FALLBACK=groq
EDGE_LLM_TIMEOUT_MS=20000

GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- timing ----------------------------------------------------------
# 20 is the demo value. Production is 90 — a nurse cannot do a physical
# check in 20 seconds, but a judge will not wait 90.
ON_DEMAND_TIMEOUT_SECONDS=20

# --- data ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EDGE_DB_PATH=edge.db
AUDIO_DIR=audio_tmp

# --- mqtt ------------------------------------------------------------
MQTT_URL=wss://your-cluster.s1.eu.hivemq.cloud:8884/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
